{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated student or tutor profile with strict role isolation.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["student", "admin"]
        },
        "gradeLevel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "role", "createdAt", "updatedAt"]
    },
    "MathsDoubt": {
      "title": "MathsDoubt",
      "description": "Any O/L Mathematics doubt submitted by a student (without topic constraints) to be discussed in bulk during live Zoom sessions.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140
        },
        "question": {
          "type": "string",
          "minLength": 5,
          "maxLength": 2500
        },
        "status": {
          "type": "string",
          "enum": ["open", "scheduled", "resolved"]
        },
        "zoomSessionId": {
          "type": "string",
          "maxLength": 128
        },
        "zoomJoinUrl": {
          "type": "string",
          "maxLength": 300
        },
        "zoomScheduledFor": {
          "type": "string",
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "studentUid",
        "studentName",
        "title",
        "question",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "ZoomSession": {
      "title": "ZoomSession",
      "description": "Free group O/L Mathematics Zoom session scheduled anytime by the tutor admin for all signed-in students to discuss bulk doubts.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 140
        },
        "zoomLink": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300,
          "pattern": "^https://"
        },
        "meetingId": {
          "type": "string",
          "maxLength": 40
        },
        "passcode": {
          "type": "string",
          "maxLength": 40
        },
        "scheduledAtIso": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40
        },
        "durationMinutes": {
          "type": "number"
        },
        "audience": {
          "type": "string",
          "enum": ["all"]
        },
        "doubtCount": {
          "type": "number"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["scheduled", "live", "completed", "cancelled"]
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tutorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "zoomLink",
        "scheduledAtIso",
        "durationMinutes",
        "audience",
        "status",
        "createdByUid",
        "tutorName",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles isolated to the owner and tutor admin."
    },
    "/doubts/{doubtId}": {
      "schema": { "$ref": "#/entities/MathsDoubt" },
      "description": "Topic-free O/L Maths doubts submitted by students for live group Zoom discussion."
    },
    "/zoomSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ZoomSession" },
      "description": "Free group Zoom sessions scheduled anytime by the tutor admin for all signed-in students."
    }
  }
}
